---
---
<header class="rdl-header">
    <div class="header-brand">
        <img src="/Logo falcont.png" alt="Logo Falcont" class="header-logo" onerror="this.onerror=null; this.src='Logo falcont.png';" style="max-height: 44px; width: auto; object-fit: contain;">
        <div>
            <span class="header-title">FALCONT HUB</span>
            <span class="header-subtitle">Despacho Contable • Portal Institucional</span>
        </div>
    </div>

    <!-- Sección Central: Buscador Global + Acciones Rápidas + Estado en Línea -->
    <div class="header-center-zone">
        <!-- Buscador Global estilo Buk / Spotlight Search -->
        <div class="header-search-wrapper" id="header-search-container">
            <div class="header-search-bar">
                <span class="search-icon">🔍</span>
                <input 
                    type="text" 
                    id="header-search-input" 
                    placeholder="Buscar colaborador, cédula, puesto o RFC..." 
                    autocomplete="off"
                />
                <div class="search-kbd-badge" title="Atajo de teclado">
                    <kbd>Ctrl</kbd> + <kbd>K</kbd>
                </div>
            </div>

            <!-- Dropdown Flotante de Resultados de Búsqueda -->
            <div class="header-search-dropdown glass-card" id="header-search-results">
                <!-- Se puebla dinámicamente desde directorio.js -->
            </div>
        </div>

        <!-- Grupo de Acciones de Navegación -->
        <div class="header-actions-group">
            <button class="btn-header-action" onclick="directorioMod.openDirectory()" title="Abrir Directorio de Colaboradores">
                👥 Directorio
            </button>
            <button class="btn-header-action btn-header-reportes" id="btn-header-reportes" onclick="reportesMod.openModal()" title="Centro de Reportes & Exportadores en Excel (Exclusivo RH)" style="display: none;">
                📊 Reportes Excel
            </button>
        </div>

        <!-- Indicador de Conexión en Línea (Discreto y Profesional) -->
        <div class="header-status-badge" id="btn-network-config" title="Conexión segura y sincronizada en tiempo real">
            <span class="pulse-green"></span>
            <span id="network-status-text">En línea</span>
        </div>
    </div>

    <div class="header-user-profile">
        <!-- Campana de Notificaciones en Tiempo Real -->
        <div class="notifications-wrapper" id="notifications-wrapper">
            <button class="btn-notification-bell" id="btn-notifications-toggle" onclick="notificacionesMod.toggleDropdown()" title="Notificaciones del Sistema">
                🔔
                <span class="notification-badge hidden" id="notifications-unread-count">0</span>
            </button>
            <div class="notifications-dropdown glass-card hidden" id="notifications-dropdown-panel">
                <div class="notifications-dropdown-header">
                    <h4>🔔 Notificaciones</h4>
                    <button class="btn-link btn-xs" onclick="notificacionesMod.markAllRead()">Marcar todas leídas</button>
                </div>
                <div class="notifications-list" id="notifications-list-container">
                    <div class="notifications-empty">No tienes notificaciones pendientes</div>
                </div>
            </div>
        </div>

        <div class="header-user-info">
            <span class="header-user-name" id="current-user-name">C.P.C. Carlos Mendoza</span>
            <span class="header-user-role" id="current-user-role-badge">Socio Director</span>
        </div>
        <button class="btn btn-ghost btn-sm" onclick="loginMod.logout()" title="Cerrar Sesión">
            🚪 Salir
        </button>
    </div>
</header>
