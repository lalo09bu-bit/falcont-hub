---
// Componente LoginForm.astro - Autenticación Passwordless mediante Magic Links
---

<div class="login-wrapper">
    <div class="login-card" id="login-card-container">
        <!-- Encabezado con Logo RDL -->
        <div class="login-header">
            <div class="logo-circle">
                <img src="/Logo RDL.png" alt="Logo RDL" class="login-logo" onerror="this.onerror=null; this.src='Logo RDL.png';" />
            </div>
            <h1 class="login-title">RDL Intelligence Hub</h1>
            <p class="login-subtitle">Plataforma Corporativa & Dirección de Talento</p>
        </div>

        <!-- Banner de Mensajes de Error (si viene por query string o validación) -->
        <div id="login-error-banner" class="login-alert error hidden">
            <span class="alert-icon">⚠️</span>
            <span id="login-error-text">El enlace mágico es inválido o ha expirado. Por favor solicita uno nuevo.</span>
        </div>

        <!-- Banner de Notificación Informativa -->
        <div id="login-info-banner" class="login-alert info hidden">
            <span class="alert-icon">ℹ️</span>
            <span id="login-info-text"></span>
        </div>

        <!-- Insignia Corporativa de Dominios Autorizados -->
        <div class="domains-badge">
            <span class="badge-icon">🛡️</span>
            <span>Acceso seguro exclusivo: <strong>@adeltaconsultores.com</strong> y <strong>@rdlabogados.com.mx</strong></span>
        </div>

        <!-- Selector de Pestañas: Iniciar Sesión vs Crear Perfil -->
        <!-- Selector de Pestañas: Iniciar Sesión vs Dar de Alta Perfil -->
        <div class="auth-tabs" id="auth-tabs-nav">
            <button type="button" class="auth-tab-btn active" id="tab-btn-login">
                🔑 Iniciar Sesión (RFC)
            </button>
            <button type="button" class="auth-tab-btn" id="tab-btn-register">
                📝 Dar de Alta Perfil
            </button>
        </div>

        <!-- 1. Formulario de Inicio de Sesión por RFC y Correo Institucional -->
        <form id="login-rfc-form" class="login-form">
            <div class="form-group">
                <label for="login-rfc" class="form-label">RFC del Colaborador</label>
                <div class="input-with-icon">
                    <span class="input-icon">🏛️</span>
                    <input 
                        type="text" 
                        id="login-rfc" 
                        name="rfc" 
                        required 
                        placeholder="Ej: COSR880101RDL" 
                        class="form-input" 
                        maxlength="13"
                        autocomplete="off"
                        style="text-transform: uppercase; font-family: monospace; font-weight: 600; letter-spacing: 0.5px;"
                    />
                </div>
                <span class="form-hint">Tu clave fiscal de registro (10 a 13 caracteres alfanuméricos).</span>
            </div>

            <div class="form-group">
                <label for="email-input" class="form-label">Correo Institucional Autorizado</label>
                <div class="input-with-icon">
                    <span class="input-icon">✉️</span>
                    <input 
                        type="email" 
                        id="email-input" 
                        name="email" 
                        required 
                        placeholder="tu.nombre@adeltaconsultores.com" 
                        class="form-input" 
                        autocomplete="email"
                    />
                </div>
                <span class="form-hint">Ingreso directo a tu perfil corporativo. Sin contraseñas.</span>
            </div>

            <button type="submit" id="btn-submit-magic" class="btn-primary-login">
                <span id="btn-text">🔑 Ingresar al Perfil</span>
                <div id="btn-spinner" class="spinner hidden"></div>
            </button>
        </form>

        <!-- 2. Formulario de Alta de Nuevo Perfil de Colaborador -->
        <form id="register-form" class="login-form hidden">
            <div class="form-group">
                <label for="reg-rfc" class="form-label">RFC del Colaborador</label>
                <div class="input-with-icon">
                    <span class="input-icon">🏛️</span>
                    <input 
                        type="text" 
                        id="reg-rfc" 
                        required 
                        placeholder="Ej: COSR880101RDL" 
                        class="form-input" 
                        maxlength="13"
                        autocomplete="off"
                        style="text-transform: uppercase; font-family: monospace; font-weight: 600; letter-spacing: 0.5px;"
                    />
                </div>
                <span class="form-hint">Registro Federal de Contribuyentes oficial.</span>
            </div>

            <div class="form-group">
                <label for="reg-email" class="form-label">Correo Institucional</label>
                <div class="input-with-icon">
                    <span class="input-icon">✉️</span>
                    <input 
                        type="email" 
                        id="reg-email" 
                        required 
                        placeholder="tu.nombre@adeltaconsultores.com" 
                        class="form-input" 
                        autocomplete="email"
                    />
                </div>
                <span class="form-hint">Debe pertenecer a @adeltaconsultores.com o @rdlabogados.com.mx</span>
            </div>

            <div class="form-group">
                <label for="reg-nombre" class="form-label">Nombre Completo</label>
                <div class="input-with-icon">
                    <span class="input-icon">👤</span>
                    <input 
                        type="text" 
                        id="reg-nombre" 
                        required 
                        placeholder="Ej: Lic. Claudia Ruiz" 
                        class="form-input" 
                    />
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label for="reg-puesto" class="form-label">Puesto / Cargo</label>
                    <input 
                        type="text" 
                        id="reg-puesto" 
                        required 
                        placeholder="Ej: Abogada Consultora" 
                        class="form-input" 
                    />
                </div>
                <div class="form-group">
                    <label for="reg-depto" class="form-label">Departamento</label>
                    <input 
                        type="text" 
                        id="reg-depto" 
                        required 
                        placeholder="Ej: Legal / Consultoría" 
                        class="form-input" 
                    />
                </div>
            </div>

            <div class="form-group">
                <label for="reg-tel" class="form-label">Teléfono Corporativo (Opcional)</label>
                <input 
                    type="tel" 
                    id="reg-tel" 
                    placeholder="+52 (55) 5482-9000" 
                    class="form-input" 
                />
            </div>

            <button type="submit" id="btn-submit-register" class="btn-primary-login" style="background-color: #136a60;">
                <span id="btn-reg-text">🚀 Dar de Alta Perfil e Ingresar</span>
                <div id="btn-reg-spinner" class="spinner hidden"></div>
            </button>
        </form>

        <!-- Pantalla de Éxito / Bienvenida al Ingresar -->
        <div id="magic-success-screen" class="success-screen hidden">
            <div class="success-icon-wrap">
                <span class="success-check">✓</span>
            </div>
            <h2 class="success-title" id="success-title">¡Acceso Correcto!</h2>
            <p class="success-desc">
                Conectando con el perfil de <strong id="sent-email-display">tu dirección institucional</strong>.
            </p>
            <div class="success-notice">
                Entrando a la plataforma corporativa RDL Intelligence Hub...
            </div>

            <div id="dev-direct-box" style="margin-bottom: 16px;">
                <a id="btn-dev-direct-login" href="/" class="btn-primary-login" style="text-decoration: none; font-size: 13px; padding: 11px 16px; background-color: #136a60;">
                    🚀 Ingresar al Hub Ahora →
                </a>
            </div>

            <button type="button" id="btn-retry-login" class="btn-link-action">
                ← Regresar a inicio de sesión
            </button>
        </div>

        <!-- Acceso Rápido de Prueba (1 Clic) para Evaluación en Azure VM / Render -->
        <div class="dev-mode-card" id="dev-quick-access-box" style="margin-top: 22px;">
            <div class="dev-mode-header">
                <span class="dev-mode-badge">⚡ ACCESO RÁPIDO CORPORATIVO (1 CLIC)</span>
                <span class="dev-mode-subtitle">Haz clic para ingresar con las credenciales oficiales de prueba:</span>
            </div>
            
            <div class="dev-buttons-stack">
                <a href="/api/auth/dev-login?email=demo@rdl.com.mx" class="btn-dev-login role-demo" title="Acceso total 360° para Auditoría y Evaluación de Clientes">
                    <span class="role-icon">⭐</span>
                    <div class="role-meta">
                        <span class="role-name">Lic. Carlos Mendoza (Cliente Demo / Auditoría)</span>
                        <span class="role-user">RFC: <strong>DEMO880101RDL</strong> • demo@rdl.com.mx</span>
                    </div>
                    <span class="role-badge">Demo 360°</span>
                </a>

                <a href="/api/auth/dev-login?role=RH&rfc=COSR880101RDL" class="btn-dev-login role-rh" title="Acceso total a Dirección de Talento">
                    <span class="role-icon">👑</span>
                    <div class="role-meta">
                        <span class="role-name">Lic. Andrés Cosmes (RH / Admin)</span>
                        <span class="role-user">RFC: <strong>COSR880101RDL</strong> • rh@rdl.com.mx</span>
                    </div>
                    <span class="role-badge">Admin</span>
                </a>

                <a href="/api/auth/dev-login?role=ABOGADA_SR&rfc=MEVR920514RDL" class="btn-dev-login role-sr" title="Supervisión legal y dictámenes">
                    <span class="role-icon">⚖️</span>
                    <div class="role-meta">
                        <span class="role-name">Lic. Valeria Mendoza (Abogada Sr)</span>
                        <span class="role-user">RFC: <strong>MEVR920514RDL</strong> • abogada.sr@rdl.com.mx</span>
                    </div>
                    <span class="role-badge">Senior</span>
                </a>

                <a href="/api/auth/dev-login?role=ABOGADA_JR&rfc=MARA950820RDL" class="btn-dev-login role-jr" title="Avance de expedientes y metas">
                    <span class="role-icon">💼</span>
                    <div class="role-meta">
                        <span class="role-name">Lic. Ana Martínez (Abogada Jr)</span>
                        <span class="role-user">RFC: <strong>MARA950820RDL</strong> • abogada.jr@rdl.com.mx</span>
                    </div>
                    <span class="role-badge">Junior</span>
                </a>
            </div>
        </div>

        <!-- Pie de tarjeta corporativo -->
        <div class="login-footer">
            <span>RDL Abogados & Consultoría • Conexión Segura TLS 1.3 & OWASP Hardened</span>
            <div style="margin-top: 6px; font-size: 11px; opacity: 0.75;">
                <a href="/.well-known/security.txt" style="color: inherit; text-decoration: underline;">Seguridad RFC 9116</a> • 
                <a href="https://rdlabogados.com.mx/aviso-de-privacidad" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline;">Aviso de Privacidad</a>
            </div>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f8fafc;
        background-image: radial-gradient(#e2e8f0 1px, transparent 1px);
        background-size: 24px 24px;
        padding: 24px;
        box-sizing: border-box;
    }

    .login-card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 30px -5px rgba(15, 45, 74, 0.08), 0 0 0 1px #e2e8f0;
        padding: 36px 32px;
        box-sizing: border-box;
    }

    .login-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .logo-circle {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(15, 45, 74, 0.1);
        border: 1px solid #e2e8f0;
        margin-bottom: 16px;
    }

    .login-logo {
        width: 44px;
        height: 44px;
        object-fit: contain;
    }

    .login-title {
        font-family: 'Outfit', -apple-system, sans-serif;
        font-size: 24px;
        font-weight: 700;
        color: #0f2d4a; /* Azul Marino Corporativo */
        margin: 0 0 6px 0;
        letter-spacing: -0.5px;
    }

    .login-subtitle {
        font-size: 13px;
        color: #64748b;
        margin: 0;
        font-weight: 500;
    }

    .login-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 20px;
        line-height: 1.4;
    }

    .login-alert.error {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .login-alert.info {
        background-color: #f0fdfa;
        border: 1px solid #ccfbf1;
        color: #115e59;
    }

    .domains-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 9px 12px;
        font-size: 11.5px;
        color: #334155;
        margin-bottom: 18px;
        text-align: center;
        line-height: 1.4;
    }

    .domains-badge strong {
        color: #0f2d4a;
    }

    .auth-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        background: #f1f5f9;
        padding: 4px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .auth-tab-btn {
        padding: 10px 14px;
        border: none;
        background: transparent;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        border-radius: 7px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .auth-tab-btn.active {
        background: #ffffff;
        color: #0f2d4a;
        box-shadow: 0 2px 6px rgba(15, 45, 74, 0.08);
    }

    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 6px;
    }

    .input-with-icon {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        font-size: 15px;
        color: #64748b;
        pointer-events: none;
    }

    .form-input {
        width: 100%;
        padding: 12px 14px 12px 42px;
        font-size: 14px;
        color: #0f2d4a;
        background-color: #ffffff;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
    }

    .form-input:focus {
        border-color: #0f2d4a;
        box-shadow: 0 0 0 3px rgba(15, 45, 74, 0.12);
    }

    .form-hint {
        display: block;
        font-size: 12px;
        color: #64748b;
        margin-top: 6px;
    }

    .btn-primary-login {
        width: 100%;
        padding: 13px 20px;
        background-color: #0f2d4a; /* Azul Marino Corporativo */
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background-color 0.2s, transform 0.1s;
    }

    .btn-primary-login:hover {
        background-color: #173f64;
    }

    .btn-primary-login:active {
        transform: scale(0.99);
    }

    .btn-primary-login:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 24px 0 16px 0;
        color: #94a3b8;
        font-size: 12px;
    }

    .divider::before, .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #e2e8f0;
    }

    .divider span {
        padding: 0 10px;
    }

    /* Estilos del Acceso Rápido Dev Mode */
    .dev-mode-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 8px;
    }

    .dev-mode-header {
        margin-bottom: 10px;
    }

    .dev-mode-badge {
        display: inline-block;
        background-color: #f1f5f9;
        color: #0f2d4a;
        border: 1px solid #cbd5e1;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 3px 8px;
        border-radius: 4px;
        margin-bottom: 4px;
    }

    .dev-mode-subtitle {
        display: block;
        font-size: 11.5px;
        color: #64748b;
    }

    .dev-buttons-stack {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .btn-dev-login {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        text-decoration: none;
        color: #1e293b;
        transition: all 0.2s;
    }

    .btn-dev-login:hover {
        border-color: #0f2d4a;
        box-shadow: 0 2px 8px rgba(15, 45, 74, 0.08);
        transform: translateY(-1px);
    }

    .btn-dev-login .role-icon {
        font-size: 18px;
        margin-right: 10px;
    }

    .btn-dev-login .role-meta {
        flex: 1;
        display: flex;
        flex-direction: column;
        text-align: left;
    }

    .btn-dev-login .role-name {
        font-size: 13px;
        font-weight: 600;
        color: #0f2d4a;
    }

    .btn-dev-login .role-user {
        font-size: 11px;
        color: #64748b;
    }

    .btn-dev-login .role-badge {
        font-size: 10px;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 4px;
        background: #e2e8f0;
        color: #334155;
    }

    .btn-dev-login.role-demo {
        background: #f0fdfa;
        border: 1.5px solid #0f766e;
    }

    .btn-dev-login.role-demo:hover {
        background: #ccfbf1;
        border-color: #14b8a6;
    }

    .btn-dev-login.role-demo .role-badge {
        background: #0f766e;
        color: #ffffff;
        font-weight: 700;
    }

    .btn-dev-login.role-rh .role-badge {
        background: #fef3c7;
        color: #92400e;
    }

    .btn-dev-login.role-sr .role-badge {
        background: #e0f2fe;
        color: #0369a1;
    }

    .btn-dev-login.role-jr .role-badge {
        background: #dcfce7;
        color: #15803d;
    }

    /* Pantalla de Éxito */
    .success-screen {
        text-align: center;
        padding: 8px 0;
    }

    .success-icon-wrap {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: #f0fdf4;
        border: 2px solid #136a60; /* Verde Pino Corporativo */
        color: #136a60;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .success-title {
        font-family: 'Outfit', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #0f2d4a;
        margin: 0 0 10px 0;
    }

    .success-desc {
        font-size: 14px;
        color: #334155;
        line-height: 1.5;
        margin: 0 0 18px 0;
    }

    .success-notice {
        background-color: #f8fafc;
        border-left: 3px solid #136a60;
        padding: 12px 14px;
        border-radius: 6px;
        font-size: 12.5px;
        color: #475569;
        text-align: left;
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .btn-link-action {
        background: none;
        border: none;
        color: #0f2d4a;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: underline;
        padding: 6px;
    }

    .btn-link-action:hover {
        color: #136a60;
    }

    .login-footer {
        margin-top: 28px;
        padding-top: 16px;
        border-top: 1px solid #f1f5f9;
        text-align: center;
        font-size: 11px;
        color: #94a3b8;
    }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    .hidden {
        display: none !important;
    }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    // Dominios institucionales autorizados
    const ALLOWED_DOMAINS = ['adeltaconsultores.com', 'adeltaconsultore.com', 'rdlabogados.com.mx', 'rdl.com.mx'];

    function isDomainAllowed(email) {
        if (!email || !email.includes('@')) return false;
        const domain = email.split('@').pop().trim().toLowerCase();
        return ALLOWED_DOMAINS.includes(domain);
    }

    // Elementos DOM
    const tabBtnLogin = document.getElementById('tab-btn-login');
    const tabBtnRegister = document.getElementById('tab-btn-register');
    const formLogin = document.getElementById('login-rfc-form');
    const formRegister = document.getElementById('register-form');

    const loginRfcInput = document.getElementById('login-rfc');
    const emailInput = document.getElementById('email-input');
    const submitBtn = document.getElementById('btn-submit-magic');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    const regRfc = document.getElementById('reg-rfc');
    const regNombre = document.getElementById('reg-nombre');
    const regEmail = document.getElementById('reg-email');
    const regPuesto = document.getElementById('reg-puesto');
    const regDepto = document.getElementById('reg-depto');
    const regTel = document.getElementById('reg-tel');
    const submitRegBtn = document.getElementById('btn-submit-register');
    const btnRegText = document.getElementById('btn-reg-text');
    const btnRegSpinner = document.getElementById('btn-reg-spinner');

    const errorBanner = document.getElementById('login-error-banner');
    const errorText = document.getElementById('login-error-text');
    const infoBanner = document.getElementById('login-info-banner');
    const infoText = document.getElementById('login-info-text');

    const successScreen = document.getElementById('magic-success-screen');
    const successTitle = document.getElementById('success-title');
    const sentEmailDisplay = document.getElementById('sent-email-display');
    const retryBtn = document.getElementById('btn-retry-login');
    const devQuickBox = document.getElementById('dev-quick-access-box');
    const devDirectBox = document.getElementById('dev-direct-box');

    // Auto-formateo a mayúsculas para los campos RFC
    if (loginRfcInput) {
        loginRfcInput.addEventListener('input', () => {
            loginRfcInput.value = loginRfcInput.value.toUpperCase().replace(/\s+/g, '');
        });
    }
    if (regRfc) {
        regRfc.addEventListener('input', () => {
            regRfc.value = regRfc.value.toUpperCase().replace(/\s+/g, '');
        });
    }

    // Revisar si la URL contiene token o errores
    const urlParams = new URLSearchParams(window.location.search);
    const tokenParam = urlParams.get('token');
    const errorParam = urlParams.get('error');

    if (tokenParam) {
        // Token recibido en URL: guardar en localStorage y entrar al Hub de inmediato
        try {
            localStorage.setItem('rdl_jwt', tokenParam);
        } catch (e) {}
        window.location.replace('/');
        return;
    }

    if (errorParam) {
        errorBanner.classList.remove('hidden');
        if (errorParam === 'usuario_no_encontrado') {
            errorText.textContent = 'El colaborador solicitado no fue encontrado en la base de datos o se encuentra inactivo.';
        } else if (errorParam === 'sesion_expirada') {
            errorText.textContent = 'Tu sesión ha finalizado. Por favor ingresa nuevamente con tu RFC y correo.';
        } else if (errorParam === 'token_expirado_o_invalido' || errorParam === 'token_invalido') {
            errorText.textContent = 'El enlace o token de acceso es inválido. Ingresa con tu RFC y correo.';
        } else {
            errorText.textContent = 'Ocurrió un detalle al verificar tu acceso institucional. Por favor intenta de nuevo.';
        }
    }

    // Modo de evaluación activo para Azure VM y Render
    if (devQuickBox) {
        devQuickBox.classList.remove('hidden');
    }

    // Gestión de pestañas (Login vs Registro)
    function switchTab(tab) {
        errorBanner.classList.add('hidden');
        infoBanner.classList.add('hidden');

        if (tab === 'login') {
            tabBtnLogin.classList.add('active');
            tabBtnRegister.classList.remove('active');
            formLogin.classList.remove('hidden');
            formRegister.classList.add('hidden');
            if (loginRfcInput) loginRfcInput.focus();
        } else {
            tabBtnLogin.classList.remove('active');
            tabBtnRegister.classList.add('active');
            formLogin.classList.add('hidden');
            formRegister.classList.remove('hidden');
            if (regRfc) regRfc.focus();
        }
    }

    if (tabBtnLogin) tabBtnLogin.addEventListener('click', () => switchTab('login'));
    if (tabBtnRegister) tabBtnRegister.addEventListener('click', () => switchTab('register'));

    // 1. Manejo del Formulario de Inicio de Sesión por RFC y Correo
    if (formLogin) {
        formLogin.addEventListener('submit', async (e) => {
            e.preventDefault();
            const rfc = (loginRfcInput ? loginRfcInput.value : '').trim().toUpperCase();
            const email = (emailInput ? emailInput.value : '').trim().toLowerCase();

            if (!rfc || !email) {
                errorBanner.classList.remove('hidden');
                errorText.textContent = 'Debes ingresar tanto tu RFC como tu correo institucional.';
                return;
            }

            if (!isDomainAllowed(email)) {
                errorBanner.classList.remove('hidden');
                infoBanner.classList.add('hidden');
                errorText.textContent = 'Acceso no autorizado. Solo se permiten correos institucionales de @adeltaconsultores.com y @rdlabogados.com.mx.';
                return;
            }

            // Estado de carga
            submitBtn.disabled = true;
            btnText.textContent = 'Verificando credenciales...';
            btnSpinner.classList.remove('hidden');
            errorBanner.classList.add('hidden');
            infoBanner.classList.add('hidden');

            try {
                const res = await fetch('/api/auth/login-rfc', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ rfc, email })
                });

                const data = await res.json();

                if (res.ok && data.success) {
                    // Guardar JWT en almacenamiento local como respaldo ante cualquier bloqueo de cookies
                    if (data.token) {
                        try {
                            localStorage.setItem('rdl_jwt', data.token);
                        } catch (e) {}
                    }

                    sentEmailDisplay.textContent = `${data.user ? data.user.nombre : email} (${rfc})`;
                    successTitle.textContent = '¡Bienvenido(a) a RDL!';
                    formLogin.classList.add('hidden');
                    formRegister.classList.add('hidden');
                    document.getElementById('auth-tabs-nav')?.classList.add('hidden');
                    successScreen.classList.remove('hidden');

                    setTimeout(() => {
                        window.location.replace(data.redirectUrl || '/');
                    }, 400);
                } else if (data.notRegistered) {
                    infoBanner.classList.remove('hidden');
                    infoText.textContent = `${data.error} Hemos completado tu RFC y correo para que te des de alta.`;
                    if (regRfc) regRfc.value = rfc;
                    if (regEmail) regEmail.value = email;
                    switchTab('register');
                } else {
                    errorBanner.classList.remove('hidden');
                    errorText.textContent = data.error || 'No fue posible iniciar sesión. Verifica tu RFC y correo.';
                }
            } catch (err) {
                console.error('Error de red al iniciar sesión por RFC:', err);
                errorBanner.classList.remove('hidden');
                errorText.textContent = 'No se pudo contactar con el servidor. Verifica tu conexión de red.';
            } finally {
                submitBtn.disabled = false;
                btnText.textContent = '🔑 Ingresar al Perfil';
                btnSpinner.classList.add('hidden');
            }
        });
    }

    // 2. Manejo del Formulario de Alta de Colaborador por RFC
    if (formRegister) {
        formRegister.addEventListener('submit', async (e) => {
            e.preventDefault();
            const rfc = (regRfc ? regRfc.value : '').trim().toUpperCase();
            const email = (regEmail ? regEmail.value : '').trim().toLowerCase();
            const nombre = (regNombre ? regNombre.value : '').trim();
            const puesto = (regPuesto ? regPuesto.value : '').trim();
            const departamento = (regDepto ? regDepto.value : '').trim();
            const telefono = (regTel ? regTel.value : '').trim();

            if (!rfc || !email || !nombre) {
                errorBanner.classList.remove('hidden');
                errorText.textContent = 'Por favor completa los campos obligatorios (RFC, Correo y Nombre Completo).';
                return;
            }

            if (!isDomainAllowed(email)) {
                errorBanner.classList.remove('hidden');
                infoBanner.classList.add('hidden');
                errorText.textContent = 'Dominio no autorizado. Solo se permite el registro con cuentas @adeltaconsultores.com o @rdlabogados.com.mx.';
                return;
            }

            submitRegBtn.disabled = true;
            btnRegText.textContent = 'Creando perfil corporativo...';
            btnRegSpinner.classList.remove('hidden');
            errorBanner.classList.add('hidden');
            infoBanner.classList.add('hidden');

            try {
                const res = await fetch('/api/auth/register-rfc', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ rfc, email, nombre, puesto, departamento, telefono })
                });

                const data = await res.json();

                if (res.ok && data.success) {
                    if (data.token) {
                        try {
                            localStorage.setItem('rdl_jwt', data.token);
                        } catch (e) {}
                    }

                    sentEmailDisplay.textContent = `${nombre} (${rfc})`;
                    successTitle.textContent = '¡Perfil Registrado con Éxito!';
                    formLogin.classList.add('hidden');
                    formRegister.classList.add('hidden');
                    document.getElementById('auth-tabs-nav')?.classList.add('hidden');
                    successScreen.classList.remove('hidden');

                    setTimeout(() => {
                        window.location.replace(data.redirectUrl || '/');
                    }, 500);
                } else {
                    errorBanner.classList.remove('hidden');
                    errorText.textContent = data.error || 'No fue posible registrar tu perfil. Por favor intenta de nuevo.';
                }
            } catch (err) {
                console.error('Error de red al registrar colaborador:', err);
                errorBanner.classList.remove('hidden');
                errorText.textContent = 'Error de conexión con el servidor.';
            } finally {
                submitRegBtn.disabled = false;
                btnRegText.textContent = '🚀 Dar de Alta Perfil e Ingresar';
                btnRegSpinner.classList.add('hidden');
            }
        });
    }

    // Botón para reintentar / volver
    if (retryBtn) {
        retryBtn.addEventListener('click', () => {
            successScreen.classList.add('hidden');
            document.getElementById('auth-tabs-nav')?.classList.remove('hidden');
            switchTab('login');
            if (loginRfcInput) loginRfcInput.focus();
        });
    }

    // Animación de entrada con GSAP
    if (typeof gsap !== 'undefined') {
        gsap.from('#login-card-container', {
            opacity: 0,
            scale: 0.96,
            y: 20,
            duration: 0.5,
            ease: 'back.out(1.2)'
        });
    }
});
</script>
