---
---
<div id="splash-screen" class="splash-screen">
    <div class="splash-content">
        <div class="logo-glow-wrapper">
            <img src="/Logo falcont.png" alt="Logo Falcont Despacho Contable" class="splash-logo-floating" id="splash-logo" onerror="this.onerror=null; this.src='Logo falcont.png';" style="max-height: 90px; width: auto; object-fit: contain;">
            <div class="green-sparkles-container">
                <span class="sparkle s1" style="background: var(--falcont-blue);"></span>
                <span class="sparkle s2" style="background: var(--falcont-blue-dark);"></span>
                <span class="sparkle s3" style="background: var(--falcont-blue);"></span>
            </div>
        </div>
        <h1 class="splash-title">FALCONT HUB</h1>
        <p class="splash-subtitle">Despacho Contable • Portal Institucional de Talento & Operaciones</p>
        
        <div class="splash-loader-bar">
            <div class="splash-loader-progress" id="splash-progress"></div>
        </div>
        <span class="splash-status-text" id="splash-status-text">Iniciando espacio de trabajo...</span>
    </div>
</div>
