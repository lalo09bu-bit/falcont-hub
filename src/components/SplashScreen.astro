---
---
<div id="splash-screen" class="splash-screen">
    <div class="splash-content">
        <div class="logo-glow-wrapper">
            <img src="/Logo RDL.png" alt="RDL Logo Corporativo" class="splash-logo-floating" id="splash-logo" onerror="this.onerror=null; this.src='Logo RDL.png';">
            <div class="green-sparkles-container">
                <span class="sparkle s1"></span>
                <span class="sparkle s2"></span>
                <span class="sparkle s3"></span>
            </div>
        </div>
        <h1 class="splash-title">RDL INTELLIGENCE HUB</h1>
        <p class="splash-subtitle">Reclutamiento e Integración de Talento</p>
        
        <div class="splash-loader-bar">
            <div class="splash-loader-progress" id="splash-progress"></div>
        </div>
        <span class="splash-status-text" id="splash-status-text">Iniciando espacio de trabajo...</span>
    </div>
</div>
