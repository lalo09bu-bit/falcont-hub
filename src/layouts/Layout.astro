---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="FALCONT Despacho Contable - Portal Institucional de Gestión de Talento & Operaciones" />
		<meta name="author" content="FALCONT Despacho Contable" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#55789B" />
		<meta name="robots" content="noindex, nofollow" />

		<!-- OpenGraph Metadata -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content="FALCONT Despacho Contable - Portal Institucional" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="FALCONT Hub" />
		
		<!-- Iconos oficiales FALCONT -->
		<link rel="icon" type="image/png" sizes="32x32" href="/Logo falcont.png" />
		<link rel="shortcut icon" type="image/png" href="/Logo falcont.png" />
		<link rel="apple-touch-icon" href="/Logo falcont.png" />
		<link rel="manifest" href="/manifest.json" />

		<title>{title}</title>

		<!-- Google Fonts: Outfit & Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">

		<!-- GSAP & Socket.io -->
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.5/socket.io.min.js"></script>

		<!-- Floating UI Web CDN -->
		<script is:inline src="https://cdn.jsdelivr.net/npm/@floating-ui/core@1.6.8"></script>
		<script is:inline src="https://cdn.jsdelivr.net/npm/@floating-ui/dom@1.6.10"></script>

		<link rel="stylesheet" href="/css/styles.css" />
	</head>
	<body class="rdl-theme">
		<slot />
	</body>
</html>
