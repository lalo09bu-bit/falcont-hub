---
import Layout from '../layouts/Layout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import Header from '../components/Header.astro';
---

<Layout title="RDL Intelligence Hub - Portal Institucional">
	<!-- 1. Pantalla Splash Flotante -->
	<SplashScreen />

	<!-- 2. Workspace Principal Protegido por Sesión Corporativa -->
	<div class="app-layout hidden" id="main-app-layout">
		<Header />

		<div class="rdl-workspace">
			<!-- Selector de Vistas para Teléfonos Móviles y Tablets -->
			<div class="mobile-tab-nav" id="mobile-views-selector">
				<button class="mobile-nav-btn active" id="btn-mobile-feed" onclick="switchMobileView('feed')">
					📰 Muro & Anuncios
				</button>
				<button class="mobile-nav-btn" id="btn-mobile-perfil" onclick="switchMobileView('perfil')">
					👤 Ficha & Metas
				</button>
			</div>

			<!-- Panel Izquierdo: Ficha del Empleado & Metas Ponderadas -->
			<aside class="left-panel mobile-hidden" id="rdl-left-panel">
				<div class="glass-card employee-card floating-element">
					<div class="card-tag">Ficha de Colaborador</div>
					<div class="employee-avatar-wrapper">
						<div class="employee-avatar" id="emp-avatar">AM</div>
						<div class="green-online-badge"></div>
					</div>
					
					<h2 class="employee-name" id="emp-name">Lic. Ana Martinez</h2>
					<span class="employee-puesto" id="emp-puesto">Abogada Junior de Litigio</span>
					<span class="employee-dept" id="emp-dept">Departamento Legal RDL</span>

					<div class="divider"></div>

					<!-- Saldo de Vacaciones -->
					<div class="vacations-box floating-element">
						<div class="vacations-header">
							<span>Saldo de Vacaciones</span>
							<button class="btn-link" onclick="vacacionesMod.openModal()">Solicitar</button>
						</div>
						<div class="vacations-gauge-container">
							<div class="vacation-circle">
								<span class="vacation-days-number" id="emp-vacations-remaining">10</span>
								<span class="vacation-days-label">Días Libres</span>
							</div>
						</div>
						<div class="vacations-stats">
							<div class="vstat">
								<span class="vstat-num" id="emp-vacations-total">12</span>
								<span class="vstat-lbl">Totales</span>
							</div>
							<div class="vstat">
								<span class="vstat-num" id="emp-vacations-taken">2</span>
								<span class="vstat-lbl">Tomados</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Módulo de Metas Ponderadas (100%) -->
				<div class="glass-card metas-card floating-element">
					<div class="metas-header">
						<div>
                            <h3 style="font-size: 1.05rem; font-weight: 700;">Metas & KPIs Ponderados</h3>
                            <span style="font-size: 0.72rem; color: var(--text-dim);">Ponderación Total: 100%</span>
                        </div>
						<div style="display: flex; gap: 8px; align-items: center;">
                            <span class="metas-badge" id="metas-count-badge">0 Metas</span>
                            <button id="btn-admin-manage-metas" class="btn btn-ghost btn-sm hidden" onclick="metasMod.openAdminModal()" title="Administrar Metas del Equipo">
                                ⚙️ Gestionar
                            </button>
                        </div>
					</div>

                    <!-- Resumen de Calificación Ponderada Global -->
                    <div class="metas-summary-box">
                        <div class="summary-score-wrapper">
                            <div class="score-radial">
                                <span class="score-number" id="emp-weighted-score">0%</span>
                                <span class="score-label">Desempeño Global</span>
                            </div>
                            <div class="score-details">
                                <div class="weight-balance-row">
                                    <span>Suma de Pesos:</span>
                                    <strong id="emp-total-weights">0% / 100%</strong>
                                </div>
                                <div class="weight-balance-bar-bg">
                                    <div class="weight-balance-bar-fill" id="weight-balance-bar"></div>
                                </div>
                                <span class="weight-status-text" id="weight-status-msg">Verificando ponderación...</span>
                            </div>
                        </div>
                    </div>

                    <!-- Lista Dinámica de Metas -->
					<div class="metas-list" id="metas-list-container"></div>

                    <!-- Banner de Acceso al Centro de Reportes & Exportadores (Solo RH) -->
                    <div class="reportes-quick-banner" id="left-panel-reportes-banner" style="display: none; margin-top: 14px;">
                        <button type="button" class="btn btn-full" onclick="reportesMod.openModal()" style="display: flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700; padding: 10px 14px; background: rgba(15, 118, 110, 0.1); border: 1.5px solid var(--rdl-teal); color: var(--rdl-teal); border-radius: 8px; cursor: pointer; transition: all 0.2s ease;">
                            <span>📊</span> Centro de Reportes & Excel
                        </button>
                    </div>
				</div>
			</aside>

			<!-- Panel Central: Muro estilo Facebook -->
			<main class="center-panel" id="rdl-center-panel">
				<div class="glass-card post-composer floating-element" id="post-composer-card">
					<div class="composer-header">
						<div class="user-avatar-sm" id="composer-user-avatar">SR</div>
						<span class="composer-prompt">¿Qué deseas publicar hoy para el equipo de RDL?</span>
					</div>
					
					<form id="form-create-post">
						<div class="form-group">
							<input type="text" id="post-titulo" placeholder="Título del anuncio o aviso corporativo..." required>
						</div>
						<div class="form-group">
							<textarea id="post-contenido" rows="3" placeholder="Escribe el mensaje o comunicado oficial..." required></textarea>
						</div>
						
						<!-- Contenedor de Vista Previa de Imagen Adjunta -->
						<div id="post-image-preview-wrapper" class="hidden" style="margin-bottom: 12px; position: relative; border-radius: 8px; overflow: hidden; border: 1px solid var(--border-light); background: #f8fafc; max-height: 260px; text-align: center;">
							<img id="post-image-preview" src="" alt="Vista previa" style="max-width: 100%; max-height: 250px; object-fit: contain; display: inline-block;">
							<button type="button" id="btn-remove-post-image" style="position: absolute; top: 8px; right: 8px; background: rgba(15, 23, 42, 0.75); color: white; border: none; border-radius: 50%; width: 28px; height: 28px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: bold;" title="Quitar imagen">✕</button>
						</div>

						<input type="file" id="post-imagen-input" accept="image/png, image/jpeg, image/jpg, image/webp" class="hidden">

						<div class="composer-actions" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
							<div style="display: flex; align-items: center; gap: 8px;">
								<select id="post-categoria" class="select-sm">
									<option value="Corporativo">📢 Corporativo</option>
									<option value="Aviso Legal">⚖️ Aviso Legal</option>
									<option value="Integracion">🎉 Integración</option>
									<option value="Urgente">🚨 Urgente</option>
								</select>

								<button type="button" class="btn btn-ghost btn-sm" id="btn-trigger-post-image" title="Adjuntar fotografía o volante">
									📷 <span class="attach-label">Foto / Imagen</span>
								</button>
							</div>

							<button type="submit" class="btn btn-primary" id="btn-submit-post">
								Publicar en el Muro RDL
							</button>
						</div>
					</form>
				</div>

				<!-- Aviso para Abogada JR -->
				<div class="glass-card jr-notice-card hidden" id="jr-notice-card">
					<div class="notice-content">
						<span>ℹ️</span>
						<p><strong>Muro de Comunicación General RDL:</strong> Como Abogada JR puedes leer, dar Me Gusta y comentar las publicaciones oficiales.</p>
					</div>
				</div>

				<!-- Feed de Publicaciones -->
				<div class="feed-stream" id="feed-stream-container"></div>
			</main>
		</div>
	</div>

    <!-- Modal de Gestión de Metas para Administrador -->
    <div class="modal-overlay" id="modal-gestionar-metas">
        <div class="modal-card glass-card" style="max-width: 780px; max-height: 90vh; display: flex; flex-direction: column;">
            <div class="modal-header">
                <h2>🎯 Gestión y Asignación de Metas Ponderadas</h2>
                <button class="btn-close" onclick="metasMod.closeAdminModal()">✕</button>
            </div>
            
            <div class="modal-body" style="overflow-y: auto; padding-right: 6px;">
                <!-- Selector de Perfil a Administrar -->
                <div class="admin-user-selector-bar">
                    <label style="font-weight: 600; font-size: 0.9rem;">Colaboradora Seleccionada:</label>
                    <select id="gm-select-user" class="select-sm" style="flex-grow: 1; height: 38px;" onchange="metasMod.onSelectUserToManage(this.value)">
                        <!-- Se puebla dinámicamente con las colaboradoras -->
                    </select>
                </div>

                <!-- Resumen de Ponderación en Vivo -->
                <div class="admin-weights-indicator-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span>Balance de Pesos Asignados:</span>
                        <span id="gm-weight-total-badge" class="badge-weight-ok">100% / 100%</span>
                    </div>
                    <div class="weight-balance-bar-bg" style="height: 10px;">
                        <div class="weight-balance-bar-fill" id="gm-weight-bar" style="width: 100%;"></div>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-dim); margin-top: 4px;">
                        <span id="gm-weight-feedback">✅ Ponderación completa (100%)</span>
                        <span>Desempeño Global: <strong id="gm-overall-score" style="color: var(--accent-green-bright);">0%</strong></span>
                    </div>
                </div>

                <!-- Formulario para Asignar Nueva Meta -->
                <div class="admin-add-meta-section">
                    <h3 style="font-size: 0.95rem; margin-bottom: 12px; color: var(--accent-green-bright);">➕ Asignar Nueva Meta al Perfil</h3>
                    <form id="form-admin-add-meta" onsubmit="metasMod.handleAddMeta(event)">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Nombre de la Meta</label>
                                <input type="text" id="gm-meta-titulo" placeholder="Ej: Revisión y Dictamen de Expedientes" required>
                            </div>
                            <div class="form-group">
                                <label>Categoría</label>
                                <select id="gm-meta-categoria" class="select-sm" style="width: 100%; height: 38px;">
                                    <option value="Caso Legal">⚖️ Caso Legal</option>
                                    <option value="Desempeño">📈 Desempeño</option>
                                    <option value="Capacitación">🎓 Capacitación</option>
                                    <option value="OKR">🎯 OKR Estratégico</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Descripción Operativa</label>
                            <textarea id="gm-meta-descripcion" rows="2" placeholder="Detalle y alcance de la meta..." required></textarea>
                        </div>

                        <div class="form-group">
                            <label>Indicador Tangible / KPI (Métrica de Éxito)</label>
                            <input type="text" id="gm-meta-indicador" placeholder="Ej: 15 expedientes dictaminados por semana (≥95% efectividad)" required>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Peso Ponderado (%) <span style="color: var(--accent-green-bright);">(Suma debe dar 100)</span></label>
                                <input type="number" id="gm-meta-peso" value="25" min="1" max="100" step="0.5" required>
                            </div>
                            <div class="form-group">
                                <label>Avance Inicial (%)</label>
                                <input type="number" id="gm-meta-avance" value="0" min="0" max="100" step="1" required>
                            </div>
                            <div class="form-group">
                                <label>Fecha Límite</label>
                                <input type="date" id="gm-meta-fecha" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-full" style="margin-top: 8px;">
                            Guardar y Asignar Meta
                        </button>
                    </form>
                </div>

                <div class="divider" style="margin: 20px 0;"></div>

                <!-- Lista de Metas Asignadas del Perfil -->
                <h3 style="font-size: 0.95rem; margin-bottom: 12px;">📋 Metas Actuales del Colaborador</h3>
                <div class="table-container" style="max-height: 240px; overflow-y: auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Meta & Indicador</th>
                                <th>Peso (%)</th>
                                <th>Avance (%)</th>
                                <th>Estatus</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody id="admin-metas-table-body">
                            <!-- Se puebla dinámicamente -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

	<!-- Modal de Ausencias: Vacaciones y Permisos con/sin goce por hora o día -->
	<div class="modal-overlay" id="modal-vacaciones">
        <div class="modal-card glass-card" style="max-width: 680px; max-height: 90vh; display: flex; flex-direction: column;">
            <div class="modal-header">
                <h2>📋 Justificación de Ausencias & Incidencias</h2>
                <button class="btn-close" onclick="vacacionesMod.closeModal()">✕</button>
            </div>
            <div class="modal-body" style="overflow-y: auto; padding-right: 6px;">
                <!-- Pestañas de Modalidad de Ausencia -->
                <div class="ausencia-modal-tabs" style="display: flex; gap: 8px; margin-bottom: 16px; border-bottom: 1px solid var(--border-light); padding-bottom: 10px;">
                    <button type="button" class="btn btn-sm btn-primary active" id="tab-btn-vacaciones" onclick="vacacionesMod.switchTab('vacaciones')" style="flex: 1;">
                        🏖️ 1. Vacaciones
                    </button>
                    <button type="button" class="btn btn-sm btn-ghost" id="tab-btn-permisos" onclick="vacacionesMod.switchTab('permisos')" style="flex: 1;">
                        ⏱️ 2. Permiso de Ausencia (Hora / Día)
                    </button>
                </div>

                <!-- Aviso de Notificación al Líder Directo -->
                <div class="leader-notify-banner" id="ausencia-leader-banner" style="display: flex; align-items: center; gap: 10px; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 8px; padding: 10px 14px; margin-bottom: 16px;">
                    <span style="font-size: 1.4rem;">👑</span>
                    <div style="font-size: 0.84rem; line-height: 1.4; color: var(--text-main);">
                        <strong>Autorización y Notificación:</strong> Esta solicitud será notificada y enviada para autorización a tu líder directo: <span id="vac-target-leader-name" style="color: var(--accent-green-bright); font-weight: 700;">Dirección de RH</span>.
                    </div>
                </div>

                <!-- Formulario 1: Vacaciones -->
                <form id="form-solicitar-vacaciones" onsubmit="vacacionesMod.submitVacaciones(event)">
                    <div class="vacations-balance-notice" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; background: var(--bg-alt); padding: 8px 12px; border-radius: 6px;">
                        <span style="font-size: 0.85rem; color: var(--text-muted);">Saldo actual disponible:</span>
                        <strong id="vac-available-days-badge" style="color: var(--accent-green-bright); font-size: 1rem;">10 días libres</strong>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Fecha Inicio</label>
                            <input type="date" id="vac-inicio" onchange="vacacionesMod.calcVacationDays()" required>
                        </div>
                        <div class="form-group">
                            <label>Fecha Fin</label>
                            <input type="date" id="vac-fin" onchange="vacacionesMod.calcVacationDays()" required>
                        </div>
                    </div>

                    <div id="vac-days-calculated-badge" style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px; padding: 6px 10px; background: rgba(255,255,255,0.04); border-radius: 4px;">
                        Días a solicitar: <strong style="color: var(--text-main);">0 días</strong>
                    </div>

                    <div class="form-group">
                        <label>Motivo de la Solicitud</label>
                        <textarea id="vac-motivo" rows="2" placeholder="Motivo o justificación del periodo vacacional..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-full">
                        ✈️ Enviar Solicitud de Vacaciones
                    </button>
                </form>

                <!-- Formulario 2: Permisos de Ausencia (Hora / Día con y sin goce) -->
                <form id="form-solicitar-permiso" class="hidden" onsubmit="vacacionesMod.submitPermiso(event)">
                    <div class="form-group">
                        <label>Modalidad de Permiso</label>
                        <select id="permiso-subtipo" class="select-sm" style="width: 100%; height: 40px; font-weight: 600;" onchange="vacacionesMod.onPermisoSubtipoChange(this.value)">
                            <option value="HORA_CON_GOCE">⏱️ Permiso por HORA — Con Goce de Sueldo</option>
                            <option value="HORA_SIN_GOCE">⏱️ Permiso por HORA — Sin Goce de Sueldo</option>
                            <option value="DIA_CON_GOCE">📅 Permiso por DÍA — Con Goce de Sueldo</option>
                            <option value="DIA_SIN_GOCE">📅 Permiso por DÍA — Sin Goce de Sueldo</option>
                        </select>
                    </div>

                    <!-- Campos para Permiso por HORA -->
                    <div id="wrapper-permiso-hora">
                        <div class="form-group">
                            <label>Fecha del Permiso</label>
                            <input type="date" id="permiso-hora-fecha">
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Hora de Inicio</label>
                                <input type="time" id="permiso-hora-inicio" value="09:00" onchange="vacacionesMod.calcPermisoHours()">
                            </div>
                            <div class="form-group">
                                <label>Hora de Fin</label>
                                <input type="time" id="permiso-hora-fin" value="12:00" onchange="vacacionesMod.calcPermisoHours()">
                            </div>
                        </div>
                        <div id="permiso-hours-calculated-badge" style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px; padding: 6px 10px; background: rgba(255,255,255,0.04); border-radius: 4px;">
                            Tiempo a justificar: <strong style="color: var(--accent-green-bright);">3.0 horas</strong>
                        </div>
                    </div>

                    <!-- Campos para Permiso por DÍA -->
                    <div id="wrapper-permiso-dia" class="hidden">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Fecha de Inicio</label>
                                <input type="date" id="permiso-dia-inicio" onchange="vacacionesMod.calcPermisoDays()">
                            </div>
                            <div class="form-group">
                                <label>Fecha de Fin</label>
                                <input type="date" id="permiso-dia-fin" onchange="vacacionesMod.calcPermisoDays()">
                            </div>
                        </div>
                        <div id="permiso-days-calculated-badge" style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px; padding: 6px 10px; background: rgba(255,255,255,0.04); border-radius: 4px;">
                            Total de días: <strong style="color: var(--accent-green-bright);">1 día</strong>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Motivo o Justificación Detallada</label>
                        <textarea id="permiso-motivo" rows="2" placeholder="Describe el motivo del permiso (ej: cita médica, asunto personal, trámite oficial)..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-full" style="background: var(--rdl-teal);">
                        📩 Enviar Solicitud de Permiso al Líder Directo
                    </button>
                </form>

                <div class="divider" style="margin: 22px 0 16px 0;"></div>

                <h3>Historial de Solicitudes y Resoluciones</h3>
                <div class="table-container" style="max-height: 250px; overflow-y: auto; margin-top: 10px;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Colaborador</th>
                                <th>Modalidad</th>
                                <th>Tiempo / Horario</th>
                                <th>Líder Asignado</th>
                                <th>Estatus</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody id="vacaciones-table-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

	<!-- Modal de Ficha de Colaborador Estilo Buk -->
	<div class="modal-overlay" id="modal-perfil-colaborador">
        <div class="modal-card glass-card buk-modal-container">
            <div class="buk-modal-header-banner">
                <button class="btn-close buk-btn-close" onclick="perfilMod.closeProfile()" title="Cerrar Ficha">✕</button>
            </div>

            <div class="buk-profile-identity-bar">
                <!-- Foto de Perfil & Uploader -->
                <div class="buk-avatar-wrapper" id="buk-avatar-dropzone" title="Arrastra una foto aquí o haz clic en la cámara para cambiar">
                    <div id="buk-avatar-display" class="buk-avatar-display">
                        <!-- Se puebla con la foto o iniciales -->
                    </div>
                    <button class="buk-photo-btn" id="buk-photo-upload-trigger" title="Subir / Cambiar Foto">
                        📷
                    </button>
                    <input type="file" id="buk-photo-input" accept="image/png, image/jpeg, image/jpg, image/webp" class="hidden">
                </div>

                <!-- Datos de Identidad -->
                <div class="buk-identity-info">
                    <div class="buk-identity-top">
                        <h2 id="buk-emp-name" class="buk-name-title">Lic. Ana Martinez</h2>
                        <span id="buk-emp-role-badge" class="role-badge badge-jr">Abogada JR</span>
                        <span id="buk-emp-status-pill" class="buk-status-pill status-active">🟢 Activo</span>
                    </div>
                    <div class="buk-identity-sub">
                        <span id="buk-emp-puesto" style="color: var(--accent-green-bright); font-weight: 600;">Abogada Junior de Litigio</span>
                        <span class="buk-dot-sep">•</span>
                        <span id="buk-emp-dept" style="color: var(--text-muted);">Departamento Legal RDL</span>
                        <span class="buk-dot-sep">•</span>
                        <span id="buk-emp-id-badge" style="color: var(--text-dim); font-size: 0.8rem;">ID: RDL-001</span>
                    </div>
                </div>

                <!-- Botones de Acción de Ficha -->
                <div class="buk-identity-actions">
                    <button class="btn btn-ghost btn-sm" onclick="perfilMod.openEditGeneralDataModal()" title="Editar Datos Laborales y Personales">
                        ✏️ Editar Datos
                    </button>
                    <button class="btn btn-primary btn-sm buk-admin-only" onclick="perfilMod.switchBukTab('metas')" title="Asignar o Modificar Metas">
                        🎯 Asignar Metas
                    </button>
                </div>
            </div>

            <!-- Pestañas de Navegación estilo Buk -->
            <div class="buk-tabs-nav">
                <button class="buk-tab-btn active" id="buk-tab-btn-general" onclick="perfilMod.switchBukTab('general')">
                    📄 Datos Generales & Laborales
                </button>
                <button class="buk-tab-btn" id="buk-tab-btn-metas" onclick="perfilMod.switchBukTab('metas')">
                    🎯 Metas & KPIs Ponderados (100%)
                </button>
                <button class="buk-tab-btn" id="buk-tab-btn-vacaciones" onclick="perfilMod.switchBukTab('vacaciones')">
                    🏖️ Vacaciones & Historial
                </button>
            </div>

