	<!-- Script de Navegación Responsive para Dispositivos Móviles -->
	<script is:inline>
	function switchMobileView(view) {
		const leftPanel = document.getElementById('rdl-left-panel');
		const centerPanel = document.getElementById('rdl-center-panel');
		const btnFeed = document.getElementById('btn-mobile-feed');
		const btnPerfil = document.getElementById('btn-mobile-perfil');

		if (!leftPanel || !centerPanel) return;

		if (view === 'feed') {
			btnFeed?.classList.add('active');
			btnPerfil?.classList.remove('active');
			centerPanel.classList.remove('mobile-hidden');
			leftPanel.classList.add('mobile-hidden');
		} else {
			btnPerfil?.classList.add('active');
			btnFeed?.classList.remove('active');
			leftPanel.classList.remove('mobile-hidden');
			centerPanel.classList.add('mobile-hidden');
		}
	}
	</script>
</Layout>
